<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: slate blue instead of near-black, with a clear blue accent.
         Text colours were picked for at least 4.5:1 contrast on their backgrounds (WCAG AA). -->
    <Color x:Key="AccentColor">#2F6FEB</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#18202E" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E2738" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E2738" />
    <SolidColorBrush x:Key="CardBrush" Color="#243047" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#2B3854" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#33415C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2E3A52" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#2B3854" />
    <SolidColorBrush x:Key="SelectedItemBrush" Color="#25406F" />
    <SolidColorBrush x:Key="TabHoverBrush" Color="#25304A" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#22365C" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C4D9" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E9BB3" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3E7DF5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#245FD1" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#8DB8FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#22365C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE9B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#16392F" />
    <SolidColorBrush x:Key="CautionBrush" Color="#F7C35C" />
    <SolidColorBrush x:Key="CautionSoftBrush" Color="#3D3320" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#4A2428" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2B3854" />

    <SolidColorBrush x:Key="MouseBodyBrush" Color="#2B3854" />
    <SolidColorBrush x:Key="MouseStrokeBrush" Color="#7F8DA8" />

    <!-- Same colours under the built-in Fluent names, so standard controls (check boxes, sliders, focus) match. -->
    <Color x:Key="SystemAccentColor">#2F6FEB</Color>
    <Color x:Key="SystemAccentColorLight1">#4D86F2</Color>
    <Color x:Key="SystemAccentColorLight2">#6E9FF7</Color>
    <Color x:Key="SystemAccentColorLight3">#8DB8FF</Color>
    <Color x:Key="SystemAccentColorDark1">#2560D2</Color>
    <Color x:Key="SystemAccentColorDark2">#1C4CAB</Color>
    <Color x:Key="SystemAccentColorDark3">#143984</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4D86F2" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5B8FF3" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3E7DF5" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8DB8FF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#8DB8FF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6E9FF7" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8C4D9" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8E9BB3" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#243047" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#33415C" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#4ADE9B" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#16392F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F7C35C" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#2B3854" />
</ResourceDictionary>
