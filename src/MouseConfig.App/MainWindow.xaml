<Window x:Class="MouseConfig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MouseConfig.App.ViewModels"
        xmlns:views="clr-namespace:MouseConfig.App.Views"
        Title="Mouse Config"
        WindowStartupLocation="CenterScreen"
        MinWidth="860" MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Sidebar: app name, mice, theme ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,16,16,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="19" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentBrush}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mouse Config" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Set up any mouse" Style="{StaticResource Note}" />
                    </StackPanel>
                </StackPanel>

                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                    <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Padding="7,4"
                            ToolTip="Look for mice again" AutomationProperties.Name="Look for mice again">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" />
                    </Button>
                    <TextBlock Text="YOUR MICE" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Theme switch -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,12,0,0">
                    <TextBlock Text="LOOK" Style="{StaticResource Overline}" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" Style="{StaticResource PillList}"
                             ItemContainerStyle="{StaticResource CompactPillItem}" AutomationProperties.Name="Theme">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThemeChoice}">
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Name}">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding HiddenText}" Style="{StaticResource Note}" Margin="4,8,0,0"
                           ToolTip="Touchpads are set up in Windows Settings, so they're left out here." />

                <Grid>
                    <ListBox ItemsSource="{Binding Mice}" SelectedItem="{Binding SelectedMouse}"
                             AutomationProperties.Name="Connected mice"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" BorderThickness="1.5"
                                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MouseViewModel}">
                                <DockPanel AutomationProperties.Name="{Binding Name}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="No mouse found" FontWeight="SemiBold" />
                            <TextBlock Text="Plug one in. This list updates on its own." Style="{StaticResource Note}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Main area: chosen mouse ===== -->
        <DockPanel Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <!-- Mouse header -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="28,16,28,0">
                <StackPanel DataContext="{Binding SelectedMouse}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" Width="48" Height="48" CornerRadius="14"
                                Margin="0,0,16,0" TextElement.FontSize="24">
                            <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <WrapPanel Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource SuccessChip}"
                                        Visibility="{Binding HasPluginChip, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding PluginChip}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent"
                        BorderThickness="0" Padding="0" Margin="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,6,20,0">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,4" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <!-- The name lets screen readers and UI Automation see the open tab's content. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Style="{StaticResource NavTab}" AutomationProperties.Name="Overview">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Overview" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:OverviewView DataContext="{Binding SelectedMouse}" />
                </TabItem>
                <TabItem Style="{StaticResource NavTab}" AutomationProperties.Name="Test buttons">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE962;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Test buttons" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:ButtonTestView DataContext="{Binding SelectedMouse.ButtonTest}" />
                </TabItem>
                <TabItem Style="{StaticResource NavTab}" AutomationProperties.Name="Pointer">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Pointer" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:PointerView DataContext="{Binding Settings}" />
                </TabItem>
                <TabItem Style="{StaticResource NavTab}" AutomationProperties.Name="Scroll">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Scroll" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:ScrollView DataContext="{Binding Settings}" />
                </TabItem>
                <TabItem Style="{StaticResource NavTab}" AutomationProperties.Name="Mouse memory">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Mouse memory" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:HardwareView DataContext="{Binding SelectedMouse.Hardware}" />
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ===== Status line: messages and problems, always visible ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,7" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}" Background="{DynamicResource SidebarBackgroundBrush}">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
