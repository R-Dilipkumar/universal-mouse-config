<UserControl x:Class="MouseConfig.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MouseConfig.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Problems reading the mouse, shown loudly -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="{DynamicResource CautionSoftBrush}"
                    BorderBrush="{DynamicResource CautionBrush}"
                    Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Margin="0,2"
                                       Foreground="{DynamicResource CautionBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="What would you like to do?" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding QuickActions}" AutomationProperties.Name="Things to do" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QuickAction}">
                        <Button Command="{Binding DataContext.GoToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding TabIndex}" Margin="0,0,12,12" Padding="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Cursor="Hand" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Style="{StaticResource Card}" Padding="16,14">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource IconBubble}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Note}" Margin="0,3,0,8" />
                                    <Border x:Name="BadgeBorder" Style="{StaticResource AccentChip}" HorizontalAlignment="Left" Margin="0">
                                        <TextBlock Text="{Binding Badge}" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="BadgeBorder" Property="Style" Value="{StaticResource Chip}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="About this mouse" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Info}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Report rate" Style="{StaticResource Dim}" Margin="0,0,20,0" />
                            <TextBlock Grid.Column="1" Text="{Binding ReportRateText}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- How this kind of mouse is set up -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="How this kind of mouse is set up" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding HowItWorks}" TextWrapping="Wrap" />
                        <TextBlock Text="MAKER'S TOOL" Style="{StaticResource Overline}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding MakerTool}" TextWrapping="Wrap" />
                        <TextBlock Text="OPEN-SOURCE TOOLS" Style="{StaticResource Overline}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding OpenTools}" TextWrapping="Wrap" />
                        <TextBlock Text="IN THIS APP" Style="{StaticResource Overline}" Margin="0,10,0,2" />
                        <TextBlock Text="{Binding HereText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Expander Header="Technical details" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Device ID" Style="{StaticResource Overline}" />
                        <TextBox Text="{Binding DeviceId, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Padding="0" MinHeight="0" TextWrapping="Wrap" AutomationProperties.Name="Device ID" Margin="0,2,0,12" />
                        <TextBlock Text="HID channels" Style="{StaticResource Overline}" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,8"
                                   Text="Each channel is one kind of signal the mouse can send. Buttons set to send keys or media keys use those channels." />
                        <ItemsControl ItemsSource="{Binding Channels}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChannelRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChName" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChMeaning" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ChUsage" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Meaning}" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Usage}" Style="{StaticResource Dim}" FontFamily="Consolas" Margin="0,0,20,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Reports}" Style="{StaticResource Dim}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
