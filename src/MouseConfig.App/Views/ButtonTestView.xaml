<UserControl x:Class="MouseConfig.App.Views.ButtonTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:MouseConfig.App.ViewModels">
    <UserControl.Resources>
        <sys:Boolean x:Key="True">True</sys:Boolean>

        <!-- A part of the mouse picture. Set Tag to a "pressed" binding; it lights up in the accent colour while true. -->
        <Style x:Key="Part" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource MouseBodyBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource MouseStrokeBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{StaticResource True}">
                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Arrow" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="{StaticResource True}">
                    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Style="{StaticResource AccentChip}" VerticalAlignment="Top">
                <TextBlock Text="Works with any mouse" />
            </Border>
            <StackPanel>
                <TextBlock Text="Test buttons" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Press each button and turn the wheel: that part lights up and is listed with what it sent. Only this mouse counts; your keyboard and touchpad are ignored." />
                <TextBlock Text="{Binding ListenState}" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Left: picture + report rate -->
        <StackPanel Grid.Row="1" Margin="0,0,24,0" Width="230">
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Viewbox Height="215" AutomationProperties.Name="Mouse picture">
                        <Canvas Width="220" Height="330">
                            <Path Style="{StaticResource Part}"
                                  Data="M110,12 C160,12 192,50 192,120 L192,225 C192,290 155,318 110,318 C65,318 28,290 28,225 L28,120 C28,50 60,12 110,12 Z" />
                            <Path Style="{StaticResource Part}" Tag="{Binding LeftPressed}"
                                  Data="M106,12.2 C58,15 28,52 28,120 L28,135 L106,135 Z" />
                            <Path Style="{StaticResource Part}" Tag="{Binding RightPressed}"
                                  Data="M114,12.2 C162,15 192,52 192,120 L192,135 L114,135 Z" />
                            <Rectangle Style="{StaticResource Part}" Tag="{Binding MiddlePressed}"
                                       Canvas.Left="99" Canvas.Top="38" Width="22" Height="60" RadiusX="11" RadiusY="11" />
                            <Path Style="{StaticResource Arrow}" Tag="{Binding WheelUpLit}" Data="M110,46 L116,55 L104,55 Z" />
                            <Path Style="{StaticResource Arrow}" Tag="{Binding WheelDownLit}" Data="M110,90 L116,81 L104,81 Z" />
                            <Path Style="{StaticResource Arrow}" Tag="{Binding TiltLeftLit}" Data="M84,68 L93,62 L93,74 Z"
                                  Visibility="{Binding HasTilt, Converter={StaticResource BoolToVisibility}}" />
                            <Path Style="{StaticResource Arrow}" Tag="{Binding TiltRightLit}" Data="M136,68 L127,62 L127,74 Z"
                                  Visibility="{Binding HasTilt, Converter={StaticResource BoolToVisibility}}" />
                            <Rectangle Style="{StaticResource Part}" Tag="{Binding ForwardPressed}"
                                       Canvas.Left="16" Canvas.Top="142" Width="14" Height="40" RadiusX="5" RadiusY="5"
                                       Visibility="{Binding HasForwardButton, Converter={StaticResource BoolToVisibility}}" />
                            <Rectangle Style="{StaticResource Part}" Tag="{Binding BackPressed}"
                                       Canvas.Left="16" Canvas.Top="188" Width="14" Height="40" RadiusX="5" RadiusY="5"
                                       Visibility="{Binding HasBackButton, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Number}" Text="1" Canvas.Left="62" Canvas.Top="76" FontSize="18" />
                            <TextBlock Style="{StaticResource Number}" Text="2" Canvas.Left="148" Canvas.Top="76" FontSize="18" />
                            <TextBlock Style="{StaticResource Number}" Text="3" Canvas.Left="106" Canvas.Top="17" FontSize="14" />
                            <TextBlock Style="{StaticResource Number}" Text="5" Canvas.Left="0" Canvas.Top="152" FontSize="14"
                                       Visibility="{Binding HasForwardButton, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Number}" Text="4" Canvas.Left="0" Canvas.Top="198" FontSize="14"
                                       Visibility="{Binding HasBackButton, Converter={StaticResource BoolToVisibility}}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource Note}" Margin="4,8,4,0" TextAlignment="Center"
                               Text="1 left · 2 right · 3 middle · 4 back · 5 forward. Side buttons may be on the other side on your mouse." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="REPORT RATE" Style="{StaticResource Overline}" />
                    <TextBlock Text="{Binding RateValue}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"
                               AutomationProperties.Name="Measured report rate" />
                    <TextBlock Text="{Binding RateText}" Style="{StaticResource Note}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right: checklist + what was sent -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Checks}" Margin="0,0,0,10" AutomationProperties.Name="Buttons to try">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CheckItem}">
                        <Border x:Name="Chip" CornerRadius="14" Padding="12,5" Margin="0,0,8,8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeBrush}" Background="{DynamicResource CardBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Mark" Text="&#xEA3A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock x:Name="Label" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Seen}" Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,10,0,0"
                       Text="Pressed a button and nothing showed up? Some buttons, like the DPI button on many mice, work inside the mouse and never reach Windows. Windows also reports at most 5 mouse buttons; extra ones only show if they send keys, media keys or data on the maker's channel." />

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" Padding="14,4" />
                <TextBlock Text="What the mouse sent" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>

            <Border Style="{StaticResource Card}" Padding="14,8">
                <Grid>
                    <TextBlock Text="Nothing yet. Press a button on your mouse." Style="{StaticResource Dim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Visibility>
                            <Binding Path="Seen.Count">
                                <Binding.Converter>
                                    <vm:ZeroToVisibleConverter />
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Seen}" Grid.IsSharedSizeScope="True" AutomationProperties.Name="What the mouse sent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SeenInput}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="What" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Dim}" FontFamily="Consolas" Margin="0,0,16,0" />
                                        <TextBlock x:Name="WhatText" Grid.Column="1" Text="{Binding What}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Channel}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFromMakerChannel}" Value="True">
                                            <Setter TargetName="WhatText" Property="FontFamily" Value="Consolas" />
                                            <Setter TargetName="WhatText" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
