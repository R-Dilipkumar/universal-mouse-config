<UserControl x:Class="MouseConfig.App.Views.ScrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="{StaticResource PageMargin}" IsEnabled="{Binding CanEdit}">
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Undo" Command="{Binding UndoScrollCommand}" Padding="14,4" Margin="0,0,8,0" />
                    <Button Content="Windows defaults" Command="{Binding ScrollDefaultsCommand}" Padding="14,4" Margin="0,0,8,0"
                            ToolTip="Puts this tab's settings back to what a fresh Windows uses." />
                    <Button Content="Restore my original settings" Command="{Binding RestoreOriginalCommand}" Padding="14,4"
                            ToolTip="Puts every Pointer and Scroll setting back to how it was before this app changed anything." />
                </StackPanel>
                <TextBlock Text="{Binding OriginalText}" Style="{StaticResource Note}" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" VerticalAlignment="Top">
                            <TextBlock Text="Windows setting · all mice" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Scroll" Style="{StaticResource PageTitle}" />
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                       Text="How far the wheel moves pages. These are Windows' own settings, so they apply to all mice. Changes apply right away." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WheelLines}" FontWeight="SemiBold" />
                                <TextBlock Text="Lines per wheel notch" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider Style="{StaticResource RowSlider}" Minimum="1" Maximum="100" TickFrequency="1"
                                    Value="{Binding WheelLines}" AutomationProperties.Name="Lines per wheel notch"
                                    IsEnabled="{Binding OneScreenAtATime, Converter={StaticResource Not}}" />
                            <TextBlock Text="Windows default is 3." Style="{StaticResource Note}" />
                            <CheckBox Content="Scroll one screen at a time instead" IsChecked="{Binding OneScreenAtATime}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WheelChars}" FontWeight="SemiBold" />
                                <TextBlock Text="Characters per sideways scroll" FontWeight="SemiBold" />
                            </DockPanel>
                            <Slider Style="{StaticResource RowSlider}" Minimum="1" Maximum="100" TickFrequency="1"
                                    Value="{Binding WheelChars}" AutomationProperties.Name="Characters per sideways scroll" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="For tilt wheels and other sideways scrolling, like touchpads. Windows default is 3." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Try it" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
                <Border Style="{StaticResource Card}" Height="330" Padding="0">
                    <ScrollViewer x:Name="TryArea" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                                  AutomationProperties.Name="Scroll test area">
                        <StackPanel x:Name="TryLines" Margin="12,8" />
                    </ScrollViewer>
                </Border>
                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0"
                           Text="Point here and turn the wheel. Each line is numbered so you can count how far one notch goes." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
